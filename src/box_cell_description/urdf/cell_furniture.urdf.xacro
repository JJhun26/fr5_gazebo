<?xml version="1.0"?>
<!--
  셀 구조물. 로봇을 뺀 나머지 전부 : 상판, 다리, 컨베이어, 팔레트 두 장,
  예외 통, 카메라 갠트리, 조명 바, 그리고 갠트리에 달린 카메라 3대.

  치수는 전부 config/cell.yaml에서 온다. 여기에 숫자를 직접 적지 않는다.

  로봇과 따로 둔 이유 :
    - Gazebo에서 이건 static 모델이다. 물리 계산에서 빠진다.
    - MoveIt은 이것을 로봇 링크가 아니라 Planning Scene 충돌체로 알아야 한다
      (기획서 5.2). scene_publisher가 같은 cell.yaml을 읽어 등록한다.
    - 따로 robot_state_publisher를 물려 두면 갠트리 카메라의 TF가 공짜로 나온다.

  좌표계 : cell.yaml의 table 좌표계. 원점은 상판 좌측 하단 모서리의 상면,
  +x = 폭 1200 방향, +y = 깊이 800 방향, +z = 위. world와는 z만 750 차이다.
-->
<robot name="box_cell_furniture" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="cell_yaml" default="$(find box_cell_description)/config/cell.yaml"/>
  <xacro:property name="cell" value="${xacro.load_yaml('$(arg cell_yaml)')}"/>

  <xacro:include filename="$(find box_cell_description)/urdf/realsense_macro.xacro"/>

  <xacro:property name="tbl"   value="${cell['table']}"/>
  <xacro:property name="conv"  value="${cell['conveyor']}"/>
  <xacro:property name="pal"   value="${cell['pallet']}"/>
  <xacro:property name="bin_"  value="${cell['exception_bin']}"/>
  <xacro:property name="th"    value="${tbl['top_thickness']}"/>
  <xacro:property name="H"     value="${cell['frame']['table_top_height']}"/>

  <!-- 구조물 밀도. 강재 프레임과 알루미늄 판의 중간쯤으로 잡는다.
       static 모델이라 물리에 쓰이지 않지만 URDF가 관성을 요구한다. -->
  <xacro:property name="rho" value="2000"/>

  <xacro:macro name="cell_box" params="name sx sy sz x y z rgba parent:='cell_base' collide:=true">
    <xacro:property name="m" value="${rho*sx*sy*sz}"/>
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <xacro:if value="${collide}">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
        </collision>
      </xacro:if>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${m}"/>
        <inertia ixx="${m*(sy*sy+sz*sz)/12}" ixy="0" ixz="0"
                 iyy="${m*(sx*sx+sz*sz)/12}" iyz="0"
                 izz="${m*(sx*sx+sy*sy)/12}"/>
      </inertial>
    </link>
    <joint name="${name}_fix" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ================= 기준 프레임 ================= -->
  <link name="world"/>
  <link name="cell_base"/>
  <joint name="cell_base_fix" type="fixed">
    <parent link="world"/>
    <child link="cell_base"/>
    <origin xyz="0 0 ${H}" rpy="0 0 0"/>
  </joint>

  <!-- ================= 상판 =================
       받침 개구 400 각을 실제로 뚫는다. 판을 네 조각으로 나눠 만든다.
       개구는 배선과 티칭 여유 때문에 300에서 400으로 정정된 값이다. -->
  <xacro:property name="op"   value="${tbl['opening']}"/>
  <xacro:property name="ox0"  value="${op['center'][0] - op['size']/2}"/>
  <xacro:property name="ox1"  value="${op['center'][0] + op['size']/2}"/>
  <xacro:property name="oy0"  value="${op['center'][1] - op['size']/2}"/>
  <xacro:property name="oy1"  value="${op['center'][1] + op['size']/2}"/>
  <xacro:property name="top_rgba" value="0.93 0.94 0.95 1"/>

  <xacro:cell_box name="table_top_left"  sx="${ox0}" sy="${tbl['size_y']}" sz="${th}"
      x="${ox0/2}" y="${tbl['size_y']/2}" z="${-th/2}" rgba="${top_rgba}"/>
  <xacro:cell_box name="table_top_right" sx="${tbl['size_x']-ox1}" sy="${tbl['size_y']}" sz="${th}"
      x="${(tbl['size_x']+ox1)/2}" y="${tbl['size_y']/2}" z="${-th/2}" rgba="${top_rgba}"/>
  <xacro:cell_box name="table_top_front" sx="${ox1-ox0}" sy="${oy0}" sz="${th}"
      x="${(ox0+ox1)/2}" y="${oy0/2}" z="${-th/2}" rgba="${top_rgba}"/>
  <xacro:cell_box name="table_top_back"  sx="${ox1-ox0}" sy="${tbl['size_y']-oy1}" sz="${th}"
      x="${(ox0+ox1)/2}" y="${(tbl['size_y']+oy1)/2}" z="${-th/2}" rgba="${top_rgba}"/>

  <!-- 개구를 덮는 받침판. 상면이 상판과 같은 높이라 로봇 베이스가 z=0에 앉는다.
       기획서의 도달 거리(414, 554, 603, 369)가 이 평면 기준이다. -->
  <xacro:cell_box name="robot_mount_plate" sx="${op['size']}" sy="${op['size']}" sz="0.012"
      x="${op['center'][0]}" y="${op['center'][1]}" z="-0.006" rgba="0.55 0.57 0.60 1"/>

  <!-- ================= 하부 캐비닛 =================
       실물 작업대는 다리 네 개에 선반이 아니라, 상판 아래가 통째로 도어
       두 짝짜리 수납장이다(현장 사진). 다리 사이가 뚫려 있으면 로봇
       배선과 컨트롤러가 갈 곳이 없다.

       충돌체로는 상판 아래라 로봇이 닿을 일이 없지만, 화면에서 셀이
       공중에 떠 보이지 않으려면 있어야 한다. -->
  <xacro:property name="inset" value="${tbl['leg']['inset']}"/>
  <xacro:property name="plinth" value="0.060"/>          <!-- 걸레받이 높이 -->
  <xacro:property name="cab_x0" value="${inset}"/>
  <xacro:property name="cab_x1" value="${tbl['size_x'] - inset}"/>
  <xacro:property name="cab_y0" value="${inset}"/>
  <xacro:property name="cab_y1" value="${tbl['size_y'] - inset}"/>
  <xacro:property name="cab_top" value="${-th}"/>
  <xacro:property name="cab_bot" value="${-H + plinth}"/>

  <!-- 몸통 -->
  <xacro:cell_box name="cabinet_body" sx="${cab_x1-cab_x0}" sy="${cab_y1-cab_y0}"
      sz="${cab_top - cab_bot}"
      x="${(cab_x0+cab_x1)/2}" y="${(cab_y0+cab_y1)/2}" z="${(cab_top+cab_bot)/2}"
      rgba="0.55 0.57 0.60 1"/>

  <!-- 걸레받이. 몸통보다 조금 들여 넣는다. -->
  <xacro:cell_box name="cabinet_plinth" sx="${cab_x1-cab_x0-0.060}" sy="${cab_y1-cab_y0-0.060}"
      sz="${plinth}"
      x="${(cab_x0+cab_x1)/2}" y="${(cab_y0+cab_y1)/2}" z="${-H + plinth/2}"
      rgba="0.30 0.31 0.33 1"/>

  <!-- 앞면 도어 두 짝. 여닫지 않는다. 생김새만 낸다. -->
  <xacro:macro name="cabinet_door" params="id x0 x1">
    <xacro:cell_box name="cabinet_door_${id}" sx="${x1-x0-0.010}" sy="0.014"
        sz="${cab_top - cab_bot - 0.020}"
        x="${(x0+x1)/2}" y="${cab_y0 - 0.007}" z="${(cab_top+cab_bot)/2}"
        rgba="0.68 0.70 0.72 1" collide="false"/>
    <!-- 세로 손잡이 -->
    <xacro:cell_box name="cabinet_handle_${id}" sx="0.016" sy="0.016" sz="0.180"
        x="${x1 - 0.055 if id == 'l' else x0 + 0.055}" y="${cab_y0 - 0.020}"
        z="${(cab_top+cab_bot)/2 + 0.060}"
        rgba="0.80 0.82 0.85 1" collide="false"/>
  </xacro:macro>
  <xacro:cabinet_door id="l" x0="${cab_x0}" x1="${(cab_x0+cab_x1)/2}"/>
  <xacro:cabinet_door id="r" x0="${(cab_x0+cab_x1)/2}" x1="${cab_x1}"/>

  <!-- 비상정지 버튼. 상판 앞쪽, 사람 손이 먼저 가는 자리다. -->
  <xacro:cell_box name="estop_base" sx="0.075" sy="0.075" sz="0.055"
      x="0.640" y="0.115" z="0.0275" rgba="0.95 0.78 0.05 1"/>
  <link name="estop_button">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.024" length="0.018"/></geometry>
      <material name="estop_mat"><color rgba="0.75 0.10 0.10 1"/></material>
    </visual>
    <inertial><mass value="0.02"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5"
      ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="estop_button_fix" type="fixed">
    <parent link="cell_base"/><child link="estop_button"/>
    <origin xyz="0.640 0.115 0.064" rpy="0 0 0"/>
  </joint>

  <!-- ================= 컨베이어 =================
       유효 800 x 폭 150. 벨트 상면이 상판 위 180. 기어박스 200 각은 상판 바깥. -->
  <xacro:property name="belt"  value="${conv['belt']}"/>
  <xacro:property name="bl_"   value="${belt['x_end'] - belt['x_start']}"/>
  <xacro:property name="bw"    value="${belt['width']}"/>
  <xacro:property name="bz"    value="${belt['surface_z']}"/>
  <xacro:property name="bt"    value="${belt['thickness']}"/>
  <xacro:property name="rail"  value="${conv['side_rail']}"/>
  <!-- 받침대와 기어박스 윗면을 벨트 판 아래로 내리는 데 쓴다. 윗면이 벨트
       상면과 같으면 박스가 흐르는 벨트가 아니라 이 정지 구조물 위에 얹혀
       움직이지 않는다. 벨트 판 두께의 두 배만큼 내려 여유를 둔다. -->
  <xacro:property name="under" value="${2 * belt['thickness']}"/>

  <!-- 이송면은 여기 없다. 통짜 벨트가 맡는다(conveyor.urdf.xacro).
       셀은 Gazebo에서 static 모델이고, static 모델에는 접촉 표면 속도가
       적용되지 않으므로 흘러야 하는 것은 별도 모델에 있어야 한다.
       여기 남은 것은 프레임, 레일, 기어박스 같은 안 움직이는 부분이다. -->

  <!-- 가이드 레일. 박스가 벨트 위에서 좌우로 빠지지 않게 잡아 준다. -->
  <xacro:cell_box name="conveyor_rail_near" sx="${bl_}" sy="${rail['thickness']}" sz="${rail['height']}"
      x="${(belt['x_start']+belt['x_end'])/2}" y="${belt['center_y'] - bw/2 + rail['thickness']/2}"
      z="${bz + rail['height']/2}" rgba="0.72 0.74 0.76 1"/>
  <xacro:cell_box name="conveyor_rail_far" sx="${bl_}" sy="${rail['thickness']}" sz="${rail['height']}"
      x="${(belt['x_start']+belt['x_end'])/2}" y="${belt['center_y'] + bw/2 - rail['thickness']/2}"
      z="${bz + rail['height']/2}" rgba="0.72 0.74 0.76 1"/>

  <!-- 벨트를 받치는 다리 두 개 -->
  <xacro:cell_box name="conveyor_stand_in" sx="0.040" sy="${bw}" sz="${bz - under}"
      x="${belt['x_start'] + 0.060}" y="${belt['center_y']}" z="${(bz - under)/2}"
      rgba="0.45 0.47 0.50 1"/>
  <xacro:cell_box name="conveyor_stand_out" sx="0.040" sy="${bw}" sz="${bz - under}"
      x="${belt['x_end'] - 0.060}" y="${belt['center_y']}" z="${(bz - under)/2}"
      rgba="0.45 0.47 0.50 1"/>

  <!-- 상류 인피드 구간. 셀 밖에서 박스를 보내 오는 앞단 라인이다.
       기획서의 유효 800(x 0~800)은 그대로 두고 그 상류에 이어 붙인 것이라,
       셀 자체의 제원은 바뀌지 않는다.

       이 구간이 있어야 기동 때 박스를 여기 줄 세워 두고 벨트가 하나씩
       끌어들일 수 있다. 실행 중에 박스를 옮기거나 지울 일이 없어진다.
       (gz의 set_pose와 remove는 true를 돌려주고 아무 일도 하지 않는다.) -->
  <xacro:property name="infeed" value="${conv['infeed']}"/>
  <xacro:property name="inf_x0" value="${infeed['x_start']}"/>
  <xacro:property name="inf_len" value="${0.0 - inf_x0}"/>

  <xacro:cell_box name="infeed_rail_near" sx="${inf_len}" sy="${rail['thickness']}" sz="${rail['height']}"
      x="${inf_x0 + inf_len/2}" y="${belt['center_y'] - bw/2 + rail['thickness']/2}"
      z="${bz + rail['height']/2}" rgba="0.68 0.70 0.72 1"/>
  <xacro:cell_box name="infeed_rail_far" sx="${inf_len}" sy="${rail['thickness']}" sz="${rail['height']}"
      x="${inf_x0 + inf_len/2}" y="${belt['center_y'] + bw/2 - rail['thickness']/2}"
      z="${bz + rail['height']/2}" rgba="0.68 0.70 0.72 1"/>
  <!-- 인피드를 받치는 다리. 상판 밖이라 바닥까지 내려간다. -->
  <xacro:cell_box name="infeed_stand_out" sx="0.040" sy="${bw}" sz="${H + bz - under}"
      x="${inf_x0 + 0.060}" y="${belt['center_y']}" z="${(bz - under - H)/2}"
      rgba="0.45 0.47 0.50 1"/>

  <xacro:property name="gb" value="${conv['gearbox']['size']}"/>
  <!-- 기어박스 윗면을 롤러 윗면보다 아래로 내린다. 같은 높이에 두면 박스가
       구동 롤러가 아니라 정지한 기어박스 위에 얹혀 영영 안 움직인다. -->
  <xacro:property name="gb_top" value="${bz - under}"/>
  <xacro:cell_box name="conveyor_gearbox" sx="${gb}" sy="${gb}" sz="${gb}"
      x="${conv['gearbox']['x_max'] - gb/2}" y="${belt['center_y']}" z="${gb_top - gb/2}"
      rgba="0.30 0.32 0.35 1"/>

  <!-- 정지 센서. 박스 중심이 stop_sensor_x에 오면 벨트가 선다.
       실물은 광전 센서다. 여기서는 표시만 두고 판정은 conveyor_driver가 한다. -->
  <xacro:cell_box name="conveyor_stop_sensor" sx="0.020" sy="0.020" sz="0.040"
      x="${conv['stop_sensor_x']}" y="${belt['center_y'] - bw/2 - 0.015}" z="${bz + 0.020}"
      rgba="0.85 0.20 0.20 1" collide="false"/>

  <!-- ================= 팔레트 두 장 =================
       실물 팔레트 모양으로 만든다. 통짜 판이 아니라 상부 데크 슬랫,
       블록, 하부 러너로 이루어진다(현장 사진의 빨간 플라스틱 팔레트).

       충돌체는 통짜 상자 하나로 둔다. 슬랫 하나하나를 충돌체로 넣으면
       MoveIt의 충돌 검사가 그만큼 무거워지는데, 로봇이 닿는 것은 데크
       상면뿐이라 얻는 게 없다. 그래서 겉모습은 슬랫으로, 충돌은 상자로
       나눠 만든다. -->
  <xacro:property name="pal_sz" value="${pal['size']}"/>
  <xacro:property name="pal_th" value="${pal['thickness']}"/>
  <xacro:property name="deck_th" value="${pal_th * 0.34}"/>   <!-- 상부 데크 -->
  <xacro:property name="blk_th"  value="${pal_th * 0.40}"/>   <!-- 블록 -->
  <xacro:property name="run_th"  value="${pal_th - deck_th - blk_th}"/>
  <xacro:property name="slat_w"  value="${pal_sz * 0.15}"/>
  <xacro:property name="pal_rgba" value="0.78 0.14 0.12 1"/>

  <xacro:macro name="pallet_slat" params="id cx cy off">
    <xacro:cell_box name="pallet_${id}_deck_${off}" sx="${pal_sz}" sy="${slat_w}" sz="${deck_th}"
        x="${cx}" y="${cy + off * pal_sz * 0.2125}" z="${pal_th - deck_th/2}"
        rgba="${pal_rgba}" collide="false"/>
  </xacro:macro>

  <xacro:macro name="pallet_block" params="id cx cy ox oy">
    <xacro:cell_box name="pallet_${id}_blk_${ox}_${oy}" sx="${slat_w}" sy="${slat_w}" sz="${blk_th}"
        x="${cx + ox * pal_sz * 0.36}" y="${cy + oy * pal_sz * 0.36}"
        z="${run_th + blk_th/2}" rgba="${pal_rgba}" collide="false"/>
  </xacro:macro>

  <xacro:macro name="pallet_unit" params="id cx cy">
    <!-- 충돌체. 데크 상면까지 통으로 잡는다. -->
    <link name="pallet_${id}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${pal_sz} ${pal_sz} ${pal_th}"/></geometry>
      </collision>
      <inertial><mass value="6.0"/><inertia ixx="0.05" iyy="0.05" izz="0.09"
        ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="pallet_${id}_fix" type="fixed">
      <parent link="cell_base"/><child link="pallet_${id}"/>
      <origin xyz="${cx} ${cy} ${pal_th/2}" rpy="0 0 0"/>
    </joint>

    <!-- 상부 데크 슬랫 5장 -->
    <xacro:pallet_slat id="${id}" cx="${cx}" cy="${cy}" off="-2"/>
    <xacro:pallet_slat id="${id}" cx="${cx}" cy="${cy}" off="-1"/>
    <xacro:pallet_slat id="${id}" cx="${cx}" cy="${cy}" off="0"/>
    <xacro:pallet_slat id="${id}" cx="${cx}" cy="${cy}" off="1"/>
    <xacro:pallet_slat id="${id}" cx="${cx}" cy="${cy}" off="2"/>

    <!-- 블록 9개 -->
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="-1" oy="-1"/>
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="-1" oy="0"/>
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="-1" oy="1"/>
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="0" oy="-1"/>
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="0" oy="0"/>
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="0" oy="1"/>
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="1" oy="-1"/>
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="1" oy="0"/>
    <xacro:pallet_block id="${id}" cx="${cx}" cy="${cy}" ox="1" oy="1"/>

    <!-- 하부 러너 3개. 지게차 포크가 들어가는 방향을 만든다. -->
    <xacro:cell_box name="pallet_${id}_run_a" sx="${pal_sz}" sy="${slat_w}" sz="${run_th}"
        x="${cx}" y="${cy - pal_sz*0.36}" z="${run_th/2}" rgba="${pal_rgba}" collide="false"/>
    <xacro:cell_box name="pallet_${id}_run_b" sx="${pal_sz}" sy="${slat_w}" sz="${run_th}"
        x="${cx}" y="${cy}" z="${run_th/2}" rgba="${pal_rgba}" collide="false"/>
    <xacro:cell_box name="pallet_${id}_run_c" sx="${pal_sz}" sy="${slat_w}" sz="${run_th}"
        x="${cx}" y="${cy + pal_sz*0.36}" z="${run_th/2}" rgba="${pal_rgba}" collide="false"/>

    <!-- 색칠 구역 200 각. 표시일 뿐이라 충돌은 뺀다. -->
    <xacro:cell_box name="pallet_${id}_zone" sx="${pal['paint_zone']}" sy="${pal['paint_zone']}" sz="0.001"
        x="${cx}" y="${cy}" z="${pal_th + 0.0005}" rgba="0.30 0.65 0.45 0.55" collide="false"/>
  </xacro:macro>
  <xacro:pallet_unit id="1" cx="${pal['units'][0]['center'][0]}" cy="${pal['units'][0]['center'][1]}"/>
  <xacro:pallet_unit id="2" cx="${pal['units'][1]['center'][0]}" cy="${pal['units'][1]['center'][1]}"/>

  <!-- ================= 예외 통 =================
       판독에 세 번 실패한 박스가 여기로 간다. 통이 차면 사람이 비운다. -->
  <xacro:property name="bx" value="${bin_['size'][0]}"/>
  <xacro:property name="by" value="${bin_['size'][1]}"/>
  <xacro:property name="bh" value="${bin_['height']}"/>
  <xacro:property name="bwall" value="${bin_['wall']}"/>
  <xacro:property name="bcx" value="${bin_['center'][0]}"/>
  <xacro:property name="bcy" value="${bin_['center'][1]}"/>
  <xacro:cell_box name="exception_bin_floor" sx="${bx}" sy="${by}" sz="${bwall}"
      x="${bcx}" y="${bcy}" z="${bwall/2}" rgba="0.85 0.35 0.35 1"/>
  <xacro:cell_box name="exception_bin_w_xmin" sx="${bwall}" sy="${by}" sz="${bh}"
      x="${bcx - bx/2 + bwall/2}" y="${bcy}" z="${bh/2}" rgba="0.85 0.35 0.35 0.75"/>
  <xacro:cell_box name="exception_bin_w_xmax" sx="${bwall}" sy="${by}" sz="${bh}"
      x="${bcx + bx/2 - bwall/2}" y="${bcy}" z="${bh/2}" rgba="0.85 0.35 0.35 0.75"/>
  <xacro:cell_box name="exception_bin_w_ymin" sx="${bx}" sy="${bwall}" sz="${bh}"
      x="${bcx}" y="${bcy - by/2 + bwall/2}" z="${bh/2}" rgba="0.85 0.35 0.35 0.75"/>
  <xacro:cell_box name="exception_bin_w_ymax" sx="${bx}" sy="${bwall}" sz="${bh}"
      x="${bcx}" y="${bcy + by/2 - bwall/2}" z="${bh/2}" rgba="0.85 0.35 0.35 0.75"/>

  <!-- ================= 카메라 지주 =================
       바닥에서 올라와 ㄱ자로 작업 구역 위로 들어오는 알루미늄 프로파일
       프레임 두 벌. 전에는 상판 위에 세운 갠트리였는데, 실물 셀은 바닥에
       선 프레임이고 상판 위 공간을 기둥이 차지하지 않는다.

       기둥은 상판 바깥(x=1.310)이지만 가로 팔은 로봇 도달 고리 안으로
       들어온다. Planning Scene 등록이 선택이 아니라 필수인 이유다.
       tools/verify_layout.py와 verify_camera_clearance.py가 매번 확인한다. -->
  <xacro:property name="cfr" value="${cell['camera_frame']}"/>
  <xacro:property name="gs" value="${cfr['section']}"/>
  <xacro:property name="floor_z" value="${cfr['floor_z']}"/>
  <xacro:property name="arm_z" value="${cfr['arm_z']}"/>
  <xacro:property name="gan_rgba" value="0.62 0.64 0.67 1"/>

  <!-- 기둥. 바닥에서 가로 팔 윗면까지. -->
  <xacro:macro name="camera_post" params="id x y">
    <xacro:cell_box name="camera_post_${id}" sx="${gs}" sy="${gs}"
        sz="${arm_z + gs/2 - floor_z}"
        x="${x}" y="${y}" z="${(arm_z + gs/2 + floor_z)/2}" rgba="${gan_rgba}"/>
    <!-- 바닥 받침판. 프로파일 프레임은 발판으로 선다. -->
    <xacro:cell_box name="camera_foot_${id}" sx="0.180" sy="0.180" sz="0.012"
        x="${x}" y="${y}" z="${floor_z + 0.006}" rgba="0.45 0.47 0.50 1"/>
  </xacro:macro>
  <xacro:camera_post id="1" x="${cfr['posts'][0]['xy'][0]}" y="${cfr['posts'][0]['xy'][1]}"/>
  <xacro:camera_post id="2" x="${cfr['posts'][1]['xy'][0]}" y="${cfr['posts'][1]['xy'][1]}"/>

  <!-- 가로 팔. 기둥에서 작업 구역 쪽으로 뻗는다. -->
  <xacro:macro name="camera_arm" params="id y x0 x1">
    <xacro:cell_box name="camera_arm_${id}" sx="${x1 - x0}" sy="${gs}" sz="${gs}"
        x="${(x0 + x1)/2}" y="${y}" z="${arm_z}" rgba="${gan_rgba}"/>
  </xacro:macro>
  <xacro:camera_arm id="conveyor" y="${cfr['arms'][0]['y']}"
      x0="${cfr['arms'][0]['x_min']}" x1="${cfr['arms'][0]['x_max']}"/>
  <xacro:camera_arm id="pallet" y="${cfr['arms'][1]['y']}"
      x0="${cfr['arms'][1]['x_min']}" x1="${cfr['arms'][1]['x_max']}"/>

  <!-- 기둥 2를 기둥 1에 잇는 짧은 가로대. 프레임이 혼자 서지 않게 묶는다. -->
  <xacro:cell_box name="camera_frame_tie" sx="${gs}"
      sy="${cfr['posts'][0]['xy'][1] - cfr['posts'][1]['xy'][1]}" sz="${gs}"
      x="${cfr['posts'][0]['xy'][0]}"
      y="${(cfr['posts'][0]['xy'][1] + cfr['posts'][1]['xy'][1])/2}"
      z="${arm_z}" rgba="${gan_rgba}"/>

  <!-- ================= 지주에 달리는 카메라 3대 ================= -->
  <xacro:property name="cams" value="${cell['cameras']}"/>

  <xacro:macro name="frame_camera" params="key">
    <xacro:property name="c" value="${cams[key]}"/>
    <!-- 카메라를 매다는 브래킷. 종류는 cell.yaml이 정한다. -->
    <xacro:if value="${c['bracket']['kind'] == 'drop'}">
      <xacro:cell_box name="${key}_bracket" sx="${cfr['drop']['section']}" sy="${cfr['drop']['section']}"
          sz="${c['bracket']['from_z'] - c['xyz'][2]}"
          x="${c['xyz'][0]}" y="${c['xyz'][1]}" z="${(c['bracket']['from_z'] + c['xyz'][2])/2}"
          rgba="0.50 0.52 0.55 1"/>
    </xacro:if>
    <xacro:realsense name="${key}" model="${c['model']}" parent="cell_base"
                     stream="${c['stream'] if 'stream' in c else None}">
      <origin xyz="${c['xyz'][0]} ${c['xyz'][1]} ${c['xyz'][2]}"
              rpy="${c['rpy'][0]} ${c['rpy'][1]} ${c['rpy'][2]}"/>
    </xacro:realsense>
  </xacro:macro>

  <xacro:frame_camera key="c1_conveyor"/>
  <xacro:frame_camera key="c2_pallet"/>
  <xacro:frame_camera key="c3_scene"/>

  <!-- Gazebo : 셀 전체가 static이다. 물리에서 빠지고 바닥에 박혀 있다. -->
  <gazebo>
    <static>true</static>
  </gazebo>

  <!-- 벨트 표면 마찰. 박스가 미끄러지지 않고 실려 가야 한다. -->

</robot>
