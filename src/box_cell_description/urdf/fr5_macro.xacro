<?xml version="1.0"?>
<!--
  FAIRINO FR5 (v6) — 6축 협동로봇. 가반 5 kg, 도달 922 mm.

  기구학, 관성, 관절 한계는 FAIRINO 공식 fairino_description(frcobot_ros2)의
  fairino5_v6.urdf 값을 그대로 옮긴 것이다. 링크 이름도 그것을 따르므로
  공식 fairino5_v6_moveit2_config의 SRDF가 수정 없이 붙는다.

  메시는 두 곳에서 가져왔다.
    visual    : fairino_gazebo fr5v6_ros2_control  meshes/fr5/visual-v6.0/*.DAE
    collision : fairino_gazebo fr5v6_ros2_control  meshes/fr5/collision-v6.0/*.STL
  두 파일 모두 링크 원점이 (0,0,0)이라 그대로 대응되며, 파일 이름만
  fairino_description의 링크 이름으로 바꿔 두었다.

  effort는 FR5 정격 토크(J1-J3 150 N·m, J4-J6 28 N·m)를 쓴다.
  fairino_gazebo는 피크값(332/63)을 넣어 두었는데, 시뮬레이션이 실물보다
  세게 나오면 안 되므로 정격을 쓴다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="fr5_link" params="name mass com ixx ixy ixz iyy iyz izz">
    <link name="${name}">
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://box_cell_description/meshes/fr5/visual/${name}.DAE"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://box_cell_description/meshes/fr5/collision/${name}.STL"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!--
    parent  : 로봇을 붙일 링크
    origin  : parent 기준 베이스 위치
    prefix  : 다중 로봇을 위한 접두어. 단일 셀에서는 빈 문자열.
  -->
  <xacro:macro name="fr5" params="parent *origin prefix:=''">

    <joint name="${prefix}base_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <xacro:fr5_link name="${prefix}base_link"
        mass="1.6185" com="-0.00031896 -0.00029673 0.042463"
        ixx="0.0030836" ixy="1.5354E-05" ixz="-1.9315E-05"
        iyy="0.0030825" iyz="-1.7918E-05" izz="0.0045209"/>
    <xacro:fr5_link name="${prefix}shoulder_link"
        mass="4.64" com="-0.00019 -0.01828 0.00226"
        ixx="0.00938391" ixy="-0.00005883" ixz="-0.00003305"
        iyy="0.0077422" iyz="0.00022287" izz="0.00932449"/>
    <xacro:fr5_link name="${prefix}upperarm_link"
        mass="10.08" com="0.21247 0.0 0.1212"
        ixx="0.02060496" ixy="0.00028019" ixz="0.00000262"
        iyy="0.43899432" iyz="-0.00000268" izz="0.435456"/>
    <xacro:fr5_link name="${prefix}forearm_link"
        mass="2.71" com="0.12262 0.00017 0.01259"
        ixx="0.00357541" ixy="0.0000957" ixz="0.00022485"
        iyy="0.07148285" iyz="0.00000343" izz="0.07111915"/>
    <xacro:fr5_link name="${prefix}wrist1_link"
        mass="1.56" com="0.00005 -0.00233 0.01468"
        ixx="0.00162595" ixy="-0.00000285" ixz="-0.00000347"
        iyy="0.0015802" iyz="0.00006131" izz="0.00125526"/>
    <xacro:fr5_link name="${prefix}wrist2_link"
        mass="1.56" com="-0.00005 0.00233 0.01468"
        ixx="0.00162595" ixy="-0.00000285" ixz="0.00000347"
        iyy="0.0015802" iyz="-0.00006131" izz="0.00125526"/>
    <xacro:fr5_link name="${prefix}wrist3_link"
        mass="0.36" com="0.00093 0.00081 -0.02005"
        ixx="0.00023009" ixy="0.00000013" ixz="0.00000098"
        iyy="0.00023049" iyz="0.00000085" izz="0.0003593"/>

    <joint name="${prefix}j1" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}shoulder_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="150" velocity="3.15"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}j2" type="revolute">
      <origin xyz="0 0 0.152" rpy="1.5708 0 0"/>
      <parent link="${prefix}shoulder_link"/>
      <child link="${prefix}upperarm_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-4.6251" upper="1.4835" effort="150" velocity="3.15"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}j3" type="revolute">
      <origin xyz="-0.425 0 0" rpy="0 0 0"/>
      <parent link="${prefix}upperarm_link"/>
      <child link="${prefix}forearm_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8274" upper="2.8274" effort="150" velocity="3.15"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}j4" type="revolute">
      <origin xyz="-0.39501 0 0" rpy="0 0 0"/>
      <parent link="${prefix}forearm_link"/>
      <child link="${prefix}wrist1_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-4.6251" upper="1.4835" effort="28" velocity="3.2"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}j5" type="revolute">
      <origin xyz="0 0 0.1021" rpy="1.5708 0 0"/>
      <parent link="${prefix}wrist1_link"/>
      <child link="${prefix}wrist2_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}j6" type="revolute">
      <origin xyz="0 0 0.102" rpy="-1.5708 0 0"/>
      <parent link="${prefix}wrist2_link"/>
      <child link="${prefix}wrist3_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

  </xacro:macro>
</robot>
