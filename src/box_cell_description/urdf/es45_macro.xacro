<?xml version="1.0"?>
<!--
  ES45-02-24V 진공 그리퍼.

  24 V I/O 장치다. 통신도 센서도 없고, 컨트롤러는 이 물건이 붙어 있는지조차
  모른다. 잡았는지 여부를 되물을 방법이 없다는 뜻이라, 상위 로직은 진공을
  켠 뒤 정해진 시간을 기다리는 것 말고 확인할 길이 없다. 시뮬레이션도
  그 성질을 그대로 둔다 : gripper_driver는 성공 여부를 돌려주지 않는다.

  치수는 앞선 세션에서 만든 fr5_es45.urdf를 그대로 옮긴 것이다.
    wrist3_link ─0.099─ 플랜지면 ─0.022─ 어댑터 ─0.0775─ 몸통 ─0.022─ 컵 끝
    TCP = wrist3_link + 0.2205 (컵 접촉면), 툴 좌표계 +z 전방

  tcp_link은 실물이 아닌 좌표계다. MoveIt의 end effector 링크로 쓴다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="es45" params="parent prefix:='' flange:=0.099">

    <joint name="${prefix}tool_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}es45_adapter"/>
      <origin xyz="0 0 ${flange}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}es45_adapter">
      <visual>
        <origin xyz="0 0 0.011" rpy="0 0 0"/>
        <geometry><cylinder radius="0.025" length="0.022"/></geometry>
        <material name="es45_adapter_mat"><color rgba="0.82 0.83 0.85 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.011" rpy="0 0 0"/>
        <geometry><cylinder radius="0.025" length="0.022"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.011" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${prefix}es45_body_mount" type="fixed">
      <parent link="${prefix}es45_adapter"/>
      <child link="${prefix}es45_body"/>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}es45_body">
      <visual>
        <origin xyz="0 0 0.03875" rpy="0 0 0"/>
        <geometry><box size="0.03 0.045 0.0775"/></geometry>
        <material name="es45_body_mat"><color rgba="0.94 0.95 0.96 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.03875" rpy="0 0 0"/>
        <geometry><box size="0.03 0.045 0.0775"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.03875" rpy="0 0 0"/>
        <mass value="0.21"/>
        <inertia ixx="2e-4" iyy="2e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${prefix}es45_cup_mount" type="fixed">
      <parent link="${prefix}es45_body"/>
      <child link="${prefix}es45_cup"/>
      <origin xyz="0 0 0.0775" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}es45_cup">
      <visual>
        <origin xyz="0 0 0.011" rpy="0 0 0"/>
        <geometry><cylinder radius="0.015" length="0.022"/></geometry>
        <material name="es45_cup_mat"><color rgba="0.15 0.15 0.17 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.011" rpy="0 0 0"/>
        <geometry><cylinder radius="0.015" length="0.022"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.011" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- 컵 접촉면. 여기가 TCP다. 붙잡은 박스는 이 링크에 붙는다. -->
    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}es45_cup"/>
      <child link="${prefix}tcp_link"/>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}tcp_link"/>

  </xacro:macro>
</robot>
